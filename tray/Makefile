NAME := libawltray.so

-include config.mk

CC ?= gcc
CXX ?= g++
LD := g++

PKGLIST := gtkmm-3.0 gtk-layer-shell-0
# headers only: menu_window.c draws through awl_host (../awl_window_draw.h)
HEADER_PKGS := fcft pixman-1

# the C files' callbacks have fixed signatures, as in awl (config.mk)
CFLAGS += -Wall -Wextra -Wno-unused-parameter -pedantic -fPIC
CXXFLAGS += -Wall -Wextra -pedantic -fPIC

FLAGS += $(shell pkg-config --cflags $(PKGLIST) $(HEADER_PKGS)) #-g -ggdb
# header dependencies, generated by the compiler alongside each object
FLAGS += -MMD -MP
# reaches awl only through awl_host (../awl_host.h)
FLAGS += -DAWL_HOSTED
# --as-needed drops the libraries pkg-config lists only because another one
# links them
LDFLAGS += -shared -Wl,--as-needed $(shell pkg-config --libs $(PKGLIST))

SRC := $(wildcard *.cpp)
CSRC := menu.c menu_window.c tooltip.c
OBJ := $(patsubst %.cpp,%.cpp.o,$(SRC)) $(patsubst %.c,%.c.o,$(CSRC))

DBUS_SRC := dbus-menu.c dbus-status-notifier-item.c dbus-status-notifier-watcher.c
DBUS_OBJ := $(patsubst %.c,%.c.o,$(DBUS_SRC))
DEPS := $(patsubst %.o,%.d,$(OBJ) $(DBUS_OBJ))

.PHONY: all clean

all: $(NAME)

$(NAME): $(OBJ) $(DBUS_OBJ)
	$(LD) $^ -o $@ $(LDFLAGS)

dbus-menu.c: protocol/dbus-menu.xml
	gdbus-codegen --c-namespace Sn --generate-c-code $(patsubst %.c,%,$@) $^
dbus-status-notifier-item.c: protocol/dbus-status-notifier-item.xml
	gdbus-codegen --c-namespace Sn --generate-c-code $(patsubst %.c,%,$@) $^
dbus-status-notifier-watcher.c: protocol/dbus-status-notifier-watcher.xml
	gdbus-codegen --c-namespace Sn --generate-c-code $(patsubst %.c,%,$@) $^

dbus-%.c.o: dbus-%.c
	$(CC) -c $< -o $@ $(filter-out -pedantic,$(CFLAGS)) $(FLAGS)

%.c.o: %.c $(DBUS_SRC)
	$(CC) -c $< -o $@ $(CFLAGS) $(FLAGS)
%.cpp.o: %.cpp $(DBUS_SRC)
	$(CXX) -c $< -o $@ $(CXXFLAGS) $(FLAGS)

clean:
	rm -f $(NAME) $(OBJ) $(DBUS_OBJ) $(DEPS)

# after all rules, so a .d file's target can't become the default goal
-include $(DEPS)
