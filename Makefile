.POSIX:
.SUFFIXES:

include config.mk

# flags for compiling
AWLCPPFLAGS = -I. -DWLR_USE_UNSTABLE -D_POSIX_C_SOURCE=200809L \
	-DVERSION=\"$(VERSION)\" $(XWAYLAND)
# AWLDEVCFLAGS = -g -Wpedantic -Wall -Wextra -Wdeclaration-after-statement \
	-Wno-unused-parameter -Wshadow -Wunused-macros -Werror=strict-prototypes \
	-Werror=implicit -Werror=return-type -Werror=incompatible-pointer-types \
	-Wfloat-conversion

# CFLAGS / LDFLAGS
PKGS      = wlroots-0.20 wayland-server xkbcommon libinput pixman-1 fcft libsystemd $(XLIBS)
AWLCFLAGS = `$(PKG_CONFIG) --cflags $(PKGS)` $(AWLCPPFLAGS) $(AWLDEVCFLAGS) $(CFLAGS)
LDLIBS    = `$(PKG_CONFIG) --libs $(PKGS)` -lm $(LIBS)

# libawlplugins.so: the plugin threads and the bar widgets, dlopen()ed by
# awl_plugin_host.c and reloaded with plugin_restart (see awl_plugin_abi.h).
PLUGINS_SRC := $(wildcard plugins/*.c)
PLUGINS_OBJ := $(patsubst %.c,%.o,$(PLUGINS_SRC)) plugins.o plugins_widgets.o plugins_desktop_panel.o plugins_config.o \
	wuffs/wuffs.o plutosvg/svg.o icons/icon.o
PLUGINS_PKGS = libpulse libsystemd pixman-1 fcft
# --as-needed drops config.mk's -lscenefx, which only awl uses
PLUGINS_LIBS = -Wl,--as-needed `$(PKG_CONFIG) --libs $(PLUGINS_PKGS)` -lm -pthread

# awl.c starts and ends awl; each awl_*.c is a part of it, see its header
AWL_OBJ := awl.o awl_config.o awl_output.o awl_bar.o awl_popup.o awl_client.o awl_xwayland.o \
	awl_layout.o awl_layer.o awl_input.o awl_cursor.o awl_lockscreen.o awl_spawn.o awl_wallpaper.o \
	awl_test.o awl_log.o awl_dict.o awl_util.o awl_draw.o awl_plugin_host.o awl_desktop.o \
	awl_background.o awl_redraw.o awl_sni.o awl_alert.o awl_window.o awl_window_draw.o \
	tray/app_env.o

# header dependencies, generated by the compiler alongside each object
DEPS := $(patsubst %.o,%.d,$(AWL_OBJ) $(PLUGINS_OBJ))

all: awl libawlplugins.so
awl: $(AWL_OBJ) libawltray-env.so
	rm -f $@
	$(CC) $(AWL_OBJ) $(AWLCFLAGS) $(LDFLAGS) $(LDLIBS) -o $@

# only awl_plugin_entry is exported; everything else binds within the library.
# AWL_HOSTED: reaches awl only through awl_host (awl_host.h)
$(PLUGINS_OBJ): AWLCFLAGS += -fPIC -fvisibility=hidden -DAWL_HOSTED \
	`$(PKG_CONFIG) --cflags $(PLUGINS_PKGS)`
# plutosvg/svg.h, the SVGs of icons/icon.c: plutovg's header by <>, and
# IEEE floats for untrusted numbers (see plutosvg/svg.c)
plutosvg/svg.o dev/plutosvg/svg.o icons/icon.o dev/icons/icon.o: AWLCFLAGS += -Iplutosvg/plutovg-1.3.3/include
plutosvg/svg.o dev/plutosvg/svg.o: AWLCFLAGS += -fno-fast-math
# preloaded into the programs awl starts with TRAY_ICONS (tray/app_env.c,
# tray/env_shim.c), found next to awl; libc only
libawltray-env.so dev/libawltray-env.so: tray/env_shim.c
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -fPIC -shared -MMD -MP -MF $(@D)/env_shim.d tray/env_shim.c $(LDFLAGS) -o $@
# libecal, for the calendar's events, is loaded at run time (plugins/cal_eds.c):
# no build dependency. ECAL_CHECK=1 checks cal_eds.c's prototypes against its
# headers, which then have to be installed.
ifeq ($(ECAL_CHECK),1)
plugins/cal_eds.o dev/plugins/cal_eds.o: AWLCFLAGS += `$(PKG_CONFIG) --cflags libecal-2.0` -DCAL_ECAL_CHECK -Wno-pedantic
endif
# linked under a temporary name and renamed, so a running awl that reloads
# mid-build reads either the old or the new library, never half of one
libawlplugins.so: $(PLUGINS_OBJ)
	$(CC) -shared $(PLUGINS_OBJ) $(AWLCFLAGS) $(PLUGINS_LIBS) $(LDFLAGS) -o $@.tmp
	mv -f $@.tmp $@
# the generated headers awl.h includes, and the config headers, before
# anything that includes them compiles (the .d files know them only after)
PROTOCOL_H = cursor-shape-v1-protocol.h pointer-constraints-unstable-v1-protocol.h \
	wlr-layer-shell-unstable-v1-protocol.h wlr-output-power-management-unstable-v1-protocol.h \
	xdg-shell-protocol.h
$(AWL_OBJ) $(PLUGINS_OBJ): | $(PROTOCOL_H) config_awl.h config_plugins.h
$(AWL_OBJ): config.mk

# make dev: dev/awl and dev/libawlplugins.so, unoptimized with full debug
# info, for test/live.sh's gdb (LIVE_AWL=dev/awl); no sanitizers, a bug
# crashes there for real. Objects go to dev/ as well, so
# the optimized build next to them stays as it is. config.mk's flags minus
# optimization and LTO.
DEVNOOPT    = -O% -flto% -march=% -mtune=%
dev/%.o dev/awl dev/libawlplugins.so dev/libawltray-env.so dev/window_unit: CFLAGS := $(filter-out $(DEVNOOPT),$(CFLAGS)) \
	-O0 -ggdb3 -fno-omit-frame-pointer
dev/awl dev/libawlplugins.so dev/libawltray-env.so dev/window_unit: LDFLAGS := $(filter-out $(DEVNOOPT),$(LDFLAGS))
DEV_AWL_OBJ     := $(addprefix dev/,$(AWL_OBJ))
DEV_PLUGINS_OBJ := $(addprefix dev/,$(PLUGINS_OBJ))
DEPS += $(patsubst %.o,%.d,$(DEV_AWL_OBJ) $(DEV_PLUGINS_OBJ)) env_shim.d dev/env_shim.d
$(DEV_PLUGINS_OBJ): AWLCFLAGS += -fPIC -fvisibility=hidden -DAWL_HOSTED \
	`$(PKG_CONFIG) --cflags $(PLUGINS_PKGS)`
$(DEV_AWL_OBJ) $(DEV_PLUGINS_OBJ): | $(PROTOCOL_H) config_awl.h config_plugins.h
$(DEV_AWL_OBJ): config.mk

dev: dev/awl dev/libawlplugins.so
dev/awl: $(DEV_AWL_OBJ) dev/libawltray-env.so
	rm -f $@
	$(CC) $(DEV_AWL_OBJ) $(AWLCFLAGS) $(LDFLAGS) $(LDLIBS) -o $@
dev/libawlplugins.so: $(DEV_PLUGINS_OBJ)
	$(CC) -shared $(DEV_PLUGINS_OBJ) $(AWLCFLAGS) $(PLUGINS_LIBS) $(LDFLAGS) -o $@.tmp
	mv -f $@.tmp $@
dev/%.o: %.c
	@mkdir -p $(@D)
	$(CC) $(CPPFLAGS) $(AWLCFLAGS) -MMD -MP -o $@ -c $<
.PHONY: dev

# make check: test/window_unit.c, awl_window_draw.c without a compositor
# (test/windows.sh tests the popups in a running awl)
dev/window_unit: test/window_unit.c dev/awl_window_draw.o dev/awl_draw.o dev/awl_log.o
	$(CC) $(CPPFLAGS) $(AWLCFLAGS) test/window_unit.c dev/awl_window_draw.o dev/awl_draw.o dev/awl_log.o \
		$(LDFLAGS) `$(PKG_CONFIG) --libs fcft pixman-1` -lm -o $@
check: dev/window_unit
	dev/window_unit
.PHONY: check
awl_util.o: awl_util.c awl_util.h

# wayland-scanner is a tool which generates C headers and rigging for Wayland
# protocols, which are specified in XML. wlroots requires you to rig these up
# to your build system yourself and provide them in the include path.
WAYLAND_SCANNER   = `$(PKG_CONFIG) --variable=wayland_scanner wayland-scanner`
WAYLAND_PROTOCOLS = `$(PKG_CONFIG) --variable=pkgdatadir wayland-protocols`

cursor-shape-v1-protocol.h:
	$(WAYLAND_SCANNER) enum-header \
		$(WAYLAND_PROTOCOLS)/staging/cursor-shape/cursor-shape-v1.xml $@
pointer-constraints-unstable-v1-protocol.h:
	$(WAYLAND_SCANNER) enum-header \
		$(WAYLAND_PROTOCOLS)/unstable/pointer-constraints/pointer-constraints-unstable-v1.xml $@
wlr-layer-shell-unstable-v1-protocol.h:
	$(WAYLAND_SCANNER) enum-header \
		protocols/wlr-layer-shell-unstable-v1.xml $@
wlr-output-power-management-unstable-v1-protocol.h:
	$(WAYLAND_SCANNER) server-header \
		protocols/wlr-output-power-management-unstable-v1.xml $@
xdg-shell-protocol.h:
	$(WAYLAND_SCANNER) server-header \
		$(WAYLAND_PROTOCOLS)/stable/xdg-shell/xdg-shell.xml $@

# on the first build, copied from their .def.h
config_awl.h config_plugins.h:
	cp $(@:.h=.def.h) $@
plugins_config.o dev/plugins_config.o: config_plugins.h
# icons/*.png embedded as static C arrays by xxd -i
icons/eyes_closed.h: icons/eyes_closed.png
	xxd -i -n icons_eyes_closed_png icons/eyes_closed.png | sed 's/^unsigned/static const unsigned/' > $@
plugins_widgets.o dev/plugins_widgets.o: icons/eyes_closed.h
# the plugin library's git revision, "branch:hash" plus ":dirty" with
# uncommitted changes to tracked files ("undef" outside git), compiled into
# plugins.o; rewritten only when it changes, so an unchanged tree doesn't relink
plugins_git.h: FORCE
	@if b=`git rev-parse --abbrev-ref HEAD 2>/dev/null` && h=`git rev-parse --short HEAD 2>/dev/null`; then \
		rev="$$b:$$h"; \
		git diff --quiet && git diff --cached --quiet || rev="$$rev:dirty"; \
	else rev=undef; fi; \
	echo "#define PLUGINS_GIT \"$$rev\"" > $@.tmp; \
	if cmp -s $@.tmp $@; then rm -f $@.tmp; else mv -f $@.tmp $@; fi
plugins.o dev/plugins.o: plugins_git.h
FORCE:
.PHONY: FORCE
clean:
	rm -f awl libawlplugins.so libawltray-env.so *.o *-protocol.h icons/eyes_closed.h plugins_git.h
	rm -f $(AWL_OBJ) $(PLUGINS_OBJ) $(DEPS)
	rm -rf dev

dist: clean
	mkdir -p awl-$(VERSION)/plugins awl-$(VERSION)/tray awl-$(VERSION)/wuffs awl-$(VERSION)/icons
	cp -R LICENSE Makefile README.md config.mk protocols \
		config_awl.def.h config_plugins.def.h \
		awl.c awl.h awl_*.c awl_*.h \
		plugins.c plugins.h plugins_*.c \
		awl-$(VERSION)
	cp plugins/*.c plugins/*.h awl-$(VERSION)/plugins
	cp wuffs/*.c wuffs/*.h awl-$(VERSION)/wuffs
	cp icons/*.png icons/icon.c icons/icon.h awl-$(VERSION)/icons
	cp tray/*.c tray/*.h awl-$(VERSION)/tray
	tar -caf awl-$(VERSION).tar.gz awl-$(VERSION)
	rm -rf awl-$(VERSION)

.SUFFIXES: .c .o
.c.o:
	$(CC) $(CPPFLAGS) $(AWLCFLAGS) -MMD -MP -o $@ -c $<

# after all rules, so a .d file's target can't become the default goal
-include $(DEPS)
